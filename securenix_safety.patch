+ # FIREWALL MODE:
+ # STRICT (default): allow required ports ONLY from MGMT_SUBNET + SAFE_IP_ADDRESSES
+ # OPEN: allow required ports globally (less secure; use only if scoring requires)
+ log "Firewall mode: $FIREWALL_MODE" "WARNING"
+ 
+ allow_port_strict() {
+     local port="$1" proto="$2" comment="$3"
+     # Always allow from mgmt subnet (Grey Team + jump infra)
+     ufw allow from "$MGMT_SUBNET" to any port "$port" proto "$proto" comment "$comment" 2>/dev/null || true
+     # Allow from each safe IP individually
+     for ip in "${SAFE_IP_ADDRESSES[@]}"; do
+         [[ "$ip" == "127.0.0.1" || "$ip" == "::1" ]] && continue
+         ufw allow from "$ip" to any port "$port" proto "$proto" comment "$comment" 2>/dev/null || true
+     done
+ }
+ 
+ allow_port_open() {
+     local port="$1" proto="$2" comment="$3"
+     ufw allow "$port/$proto" comment "$comment" 2>/dev/null || true
+ }
+ 
+ # SSH must be reachable (Rule 10). In STRICT mode, only mgmt + safe IPs can SSH.
+ if [[ "$FIREWALL_MODE" == "OPEN" ]]; then
+     log "Allowing SSH globally (OPEN mode)..." "WARNING"
+     allow_port_open 22 tcp "SSH - Rule 10 required"
+     ufw limit 22/tcp comment 'SSH rate limit' 2>/dev/null || true
+ else
+     log "Allowing SSH only from MGMT_SUBNET + SAFE_IPs (STRICT mode)..." "INFO"
+     allow_port_strict 22 tcp "SSH - Rule 10 required (strict)"
+     # UFW 'limit' can be global; in strict mode we rely on source restriction.
+ fi
+ add_change "Firewall" "SSH allowed (Rule 10)" "SUCCESS" "mode=$FIREWALL_MODE"
+ 
+ # Scoring ports (443, 444)
+ if [[ "$FIREWALL_MODE" == "OPEN" ]]; then
+     log "Allowing scoring ports globally (OPEN mode)..." "WARNING"
+     allow_port_open 443 tcp "HTTPS - Scoring portal"
+     allow_port_open 444 tcp "Scoring engine netcat"
+ else
+     log "Allowing scoring ports only from MGMT_SUBNET + SAFE_IPs (STRICT mode)..." "INFO"
+     allow_port_strict 443 tcp "HTTPS - Scoring portal (strict)"
+     allow_port_strict 444 tcp "Scoring engine netcat (strict)"
+ fi
+ add_change "Firewall" "Scoring ports allowed" "SUCCESS" "443,444 mode=$FIREWALL_MODE"
